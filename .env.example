# ---- Server (copy to .env or set in your host's dashboard; never commit real values) ----
# The server reads process.env directly; use `node --env-file=.env server/dist/index.js` or your host's env UI.

PORT=8080
HOST=0.0.0.0
NODE_ENV=development            # set to "production" when deployed

# Usually NOT needed. In production the server always accepts its own origin (page and game on the same URL),
# and it also reads the public URL that Render/Railway/Koyeb/Fly/HF inject. Set this only when the client is
# hosted on a DIFFERENT domain than the game server. Comma-separated, no "*" in production.
# Example:
# ALLOWED_ORIGINS=https://your-name.github.io,https://strike-squad.pages.dev
ALLOWED_ORIGINS=

# Serve the built client from the same process (single-host deployment). Leave empty if the client is hosted elsewhere.
CLIENT_DIR=client/dist

# Set to 1 when behind a reverse proxy (Render, Fly, Railway, Cloudflare) so per-IP limits use X-Forwarded-For.
TRUST_PROXY=0

# Optional tuning (defaults shown)
# TICK_RATE=30
# SNAPSHOT_EVERY=2
# RECONNECT_GRACE_MS=30000
# LOBBY_GRACE_MS=8000
# ROOM_IDLE_EXPIRY_MS=600000
# RESULTS_IDLE_EXPIRY_MS=300000
# MAX_CONNECTIONS_PER_IP=12
# MAX_ROOMS=200
# LOG_LEVEL=info                 # debug|info|warn|error|silent

# Tests only - the server refuses to start with this in production:
# TIME_SCALE=4

# ---- Client (build-time, read by Vite; these are public values, never put secrets here) ----
# Full WebSocket URL of the game server when the client is hosted separately from it.
# Leave unset for single-host deployments (client then uses wss://<same host>/ws).
# VITE_WS_URL=wss://your-game-server.example.com/ws
# Public origin used in invite links (defaults to the page's own origin).
# VITE_PUBLIC_ORIGIN=https://your-name.github.io

// Cloudflare Workers deployment (free plan): static client + one Durable Object running the game server.
// Deploy:  npx wrangler login  &&  npm run deploy:cloudflare     (details: docs/DEPLOYMENT.md)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strike-squad",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-06-01",
  "build": {
    // Runs before every deploy/dev: builds the browser client into client/dist.
    "command": "npm run build -w client",
  },
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    // /join/CODE invite links open the app.
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker; everything else is served straight from the static asset cache.
    "run_worker_first": ["/ws", "/health"],
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "StrikeSquadServer" }],
  },
  // Free plan Durable Objects must use the SQLite storage backend (this game stores nothing on disk anyway).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StrikeSquadServer"] }],
  "vars": {
    "NODE_ENV": "production",
    // Extra origins allowed to open the game socket (comma-separated). Same-origin connections (the default
    // *.workers.dev page) are always allowed. "https://*.crazygames.com" lets the CrazyGames build connect for
    // co-op (the portal serves the game from its own subdomains; see docs/CRAZYGAMES.md).
    "ALLOWED_ORIGINS": "https://*.crazygames.com",
    "LOG_LEVEL": "warn",
  },
  "observability": { "enabled": true },
}
